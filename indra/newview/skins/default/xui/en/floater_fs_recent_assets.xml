<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<floater
 name="fs_recent_assets"
 title="Recent Textures &amp; Materials"
 help_topic="fs_recent_assets"
 can_resize="true"
 height="300"
 width="380"
 min_width="300"
 min_height="200"
 layout="topleft"
 save_rect="true"
 single_instance="true">
    <string name="kind_texture">Texture</string>
    <string name="kind_material">Material</string>
    <string name="not_editable">Select faces you can modify first.</string>
    <string name="item_gone">That item is no longer in your inventory.</string>
    <string name="apply_failed">It couldn't be applied to the selection.</string>
    <scroll_list
     name="entries"
     layout="topleft"
     follows="all"
     left="8"
     right="-116"
     top="6"
     bottom="-74"
     draw_heading="true"
     multi_select="false"
     can_sort="false"
     tool_tip="The textures and materials you applied last, most recent first. Double-click to apply one to the selected faces.">
        <scroll_list.columns name="name" label="Name" relative_width="0.7" />
        <scroll_list.columns name="kind" label="Kind" width="64" />
    </scroll_list>
    <icon
     name="preview"
     layout="topleft"
     follows="top|right"
     left="272"
     top="6"
     width="100"
     height="100"
     image_name="Inv_Texture"
     tool_tip="The selected texture, or the base color of the selected material" />
    <text
     name="status"
     layout="topleft"
     follows="left|right|bottom"
     left="8"
     right="-8"
     bottom="-50"
     height="18"
     word_wrap="false"
     use_ellipses="true" />
    <button
     name="apply"
     label="Apply"
     tool_tip="Apply to the selected faces"
     layout="topleft"
     follows="left|bottom"
     left="8"
     bottom="-26"
     height="22"
     width="80" />
    <button
     name="clear"
     label="Clear"
     tool_tip="Forget every texture and material in this list"
     layout="topleft"
     follows="left|bottom"
     left_pad="4"
     height="22"
     width="64" />
</floater>
